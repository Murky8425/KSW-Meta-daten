[Unit]
Description=KSW Metadaten Account-Lebenszyklus prüfen
After=network-online.target

[Service]
Type=oneshot
User=rh-admin
Group=rh-admin
WorkingDirectory=/home/rh-admin/KSW-Meta-daten
EnvironmentFile=-/etc/ksw-metadata.env
ExecStart=/home/rh-admin/KSW-Meta-daten/.venv/bin/python /home/rh-admin/KSW-Meta-daten/manage.py process_account_lifecycle